<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PolyBot on a Mac. launchd starts `polybot run` when you log in and starts it again
  if it ever stops; that one process runs all seven jobs on their timetable.

  1. Replace /path/to/PolyBot below (four places) with the real folder.
  2. Copy this file to ~/Library/LaunchAgents/ and load it (see docs/always-on.md).

  The keep-awake option stops the Mac sleeping while PolyBot runs and the charger is
  plugged in. Paper trading only.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jayzhang.polybot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/PolyBot/.venv/bin/python</string>
    <string>-m</string>
    <string>polybot</string>
    <string>run</string>
    <string>--keep-awake</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/PolyBot</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ExitTimeOut</key><integer>45</integer>
  <key>StandardOutPath</key><string>/path/to/PolyBot/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/path/to/PolyBot/launchd.err.log</string>
</dict>
</plist>
